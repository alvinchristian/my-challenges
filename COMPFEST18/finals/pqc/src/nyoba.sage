from sage.all import *
from Crypto.Util.number import long_to_bytes

# ----- paste from output -----
p = 109062248464308014250425580654858163646916764147754032597104425336719315338571
pub = (-, , )
# -----------------------------

# 1) Recover private key (A, B, R) from the public key
a, b, c = map(ZZ, pub)
rhs = QQ(a**3 + b**3 + c**3) / QQ(a * b * c)

P = QQ["X, Y, Z"]
X, Y, Z = P.gens()
cubic = X**3 + Y**3 + Z**3 - rhs * X * Y * Z

f = EllipticCurve_from_cubic(cubic, [1, -1, 0])
fi = f.inverse()

G = f(pub)

A = B = R = None
for Pdiv in G.division_points(2):
    try:
        x0, y0, z0 = fi(Pdiv)
        l = lcm(lcm(x0.denominator(), y0.denominator()), z0.denominator())
        x0, y0, z0 = ZZ(x0 * l), ZZ(y0 * l), ZZ(z0 * l)
        if x0 > 0 and y0 > 0 and z0 > 0:
            if x0.is_prime() and x0.nbits() == 256 and z0.is_prime() and z0.nbits() == 1024:
                A, B, R = int(x0), int(y0), int(z0)
                break
    except Exception:
        continue

print(f"A = {A}")
print(f"B = {B}")

